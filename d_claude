#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/lib/env_mounts.sh"

COMPOSE_FILE="${SCRIPT_DIR}/claude/docker-compose.yml"
HOST_WORKDIR="$(pwd)"
PROJECT_NAME="$(basename "${HOST_WORKDIR}")"
CONTAINER_WORKDIR="/workspace/${PROJECT_NAME}"

# Build /dev/null overlay mounts for secret files
ENV_MOUNTS=()
env_null_mounts "${HOST_WORKDIR}" ENV_MOUNTS
CONFIG_MOUNT=()
agent_config_mount_args "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}" "/home/agent/.claude" CONFIG_MOUNT
AZURE_MOUNT=()
agent_config_mount_args "${AZURE_CONFIG_DIR:-${HOME}/.azure}" "/home/agent/.azure" AZURE_MOUNT
TERRAFORM_MOUNT=()
agent_config_mount_args "${HOME}/.terraform.d" "/home/agent/.terraform.d" TERRAFORM_MOUNT
TERRAFORM_CONFIG_MOUNT=()
agent_config_file_mount_args "${TF_CLI_CONFIG_FILE:-${HOME}/.terraformrc}" "/home/agent/.terraformrc" TERRAFORM_CONFIG_MOUNT
CONFIG_FILE_MOUNT=()
agent_config_file_mount_args "${CLAUDE_CONFIG_JSON:-${HOME}/.claude.json}" "/home/agent/.claude.json" CONFIG_FILE_MOUNT
AGENT_ARGS=()
agent_instructions_args "${HOST_WORKDIR}" "/home/agent/.claude/CLAUDE.md" AGENT_ARGS

# Load the host MCP token for the Claude container.
HOST_MCP_TOKEN="$(<"${HOME}/.config/mcp-runner/token")"

export HOST_UID="$(id -u)"
export HOST_GID="$(id -g)"
export HOST_WORKDIR
export CONTAINER_WORKDIR
export HOST_MCP_TOKEN

CONTAINER_NAME=""
resolve_container_name "d-claude-${PROJECT_NAME}" CONTAINER_NAME

docker compose -f "${COMPOSE_FILE}" run --rm --name "${CONTAINER_NAME}" \
  "${ENV_MOUNTS[@]+"${ENV_MOUNTS[@]}"}" \
  "${CONFIG_MOUNT[@]+"${CONFIG_MOUNT[@]}"}" \
  "${AZURE_MOUNT[@]+"${AZURE_MOUNT[@]}"}" \
  "${TERRAFORM_MOUNT[@]+"${TERRAFORM_MOUNT[@]}"}" \
  "${TERRAFORM_CONFIG_MOUNT[@]+"${TERRAFORM_CONFIG_MOUNT[@]}"}" \
  "${CONFIG_FILE_MOUNT[@]+"${CONFIG_FILE_MOUNT[@]}"}" \
  "${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"}" \
  claude
